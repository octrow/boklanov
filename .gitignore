# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# ide
.idea
.obsidian

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
temp.log

# typescript build cache
tsconfig.tsbuildinfo

# local env files
.env
.env.local
.env.build
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# obsidian - commit config, ignore runtime state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/

# claude code local settings (project skills are committed; local settings are not)
.claude/settings.local.json

# translation cache (translate-content.ts)
.cache/translate/

# runtime cache mirrored into R2 (cache/preview, cache/recordmap from older
# code paths). The backup-r2-to-git workflow allowlists image prefixes only,
# but this guard keeps it out of git locally too.
/public/cache/

# python bytecode (from skill scripts)
__pycache__/
*.pyc

# Local-only — Notion export from the pre-F8 era, kept on some workstations
# for archaeology. Not used at build/run time (loader source = Payload/Postgres
# since Phase 11). Safe to `rm -rf` locally to free disk.
/notion-data/
