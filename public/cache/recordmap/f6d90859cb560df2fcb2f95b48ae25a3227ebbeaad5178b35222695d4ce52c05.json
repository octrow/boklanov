on","is_site":true,"added_timestamp":1654279731511,"allow_duplicate":false}],"created_time":1654277936117,"last_edited_time":1759259924656,"parent_id":"b4d03d33-ed1c-4c25-bcd1-8cf05fa7d7aa","parent_table":"space","alive":true,"copied_from":"7393c361-d80a-496f-9ac3-afe64e66a16c","file_ids":["892228cd-7db5-42e6-a0a7-6e391946be36","846e5320-45c1-4ab8-aa7f-4c4016aaf5d9","36457ade-6f13-464b-87f3-dda1f09a6195","3aebe54f-ca62-47f5-8a9f-65f6f57a50df","577964c5-b0a8-4075-bca8-0f29b645e2c5","170ef558-5bf5-4f29-a219-4ea1833385ae","ffd5af31-b20a-43bd-aa4f-64c016fa2964","037794ac-4530-4871-9cad-3f205e98b55c","9fade6af-bd05-4345-8c84-a93f0bd77754","85990e96-a620-4211-b092-b704b797f28b","a21574a8-3ad9-41f6-b126-e381fcd0a958"],"space_id":"b4d03d33-ed1c-4c25-bcd1-8cf05fa7d7aa","crdt_format_version":1,"crdt_data":{"title":{"r":"X_grQwfYQFbtqoQ-Zi43zg,\"start\",\"end\"","n":{"X_grQwfYQFbtqoQ-Zi43zg,\"start\",\"end\"":{"s":{"x":"X_grQwfYQFbtqoQ-Zi43zg","i":[{"t":"s"},{"t":"t","i":["p4HUUkUd6rom",1],"o":"start","l":14,"c":"Роман Бокланов"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"e6a2fe16-9828-4269-868f-e73bec41f58b":{"value":{"value":{"id":"e6a2fe16-9828-4269-868f-e73bec41f58b","version":27,"type":"text","properties":{"title":[["«СКАЗКА РИХТЕРА» дает представление о жизни Святослава Рихтера (1915–1997), одного из величайших советских пианистов в истории музыки. Жизнь этого немецко-русского пианиста-виртуоза характеризовалась бегством от реальности сталинского режима в безграничный и ничем не ограниченный мир музыки. «Политика меня не интересует», — говорил Рихтер. Однако его судьба была пронизана этим: отец Рихтера был казнен по ложному обвинению, его мать бежала в Германию вместе с отступающими немецкими войсками, а сам Рихтер, едва избежав ареста, играл на похоронах Сталина. Произведение представляет собой фантазию на тему взаимоотношений художника и власти. Он основан на документах из архива Рихтера, а также на интервью самого художника, его коллег и близких друзей. Спектакль рассказывает историю музыкального гения, который был вынужден изобрести свой собственный «свободный мир», чтобы держаться как можно дальше от диктаторского правления, тоталитаризма и застоя. Сочетая живую музыку, элементы драматического и документального театра, а также кукольного театра и клоунады, на сцену выходит необыкновенная и фантастическая история... сказка об этой уникальной личности. "]]},"created_time":1714839765966,"last_edited_time":1720039909759,"parent_id":"bff66483-1311-4867-b890-06db1f958ce6","parent_table":"block","alive":true,"space_id":"b4d03d33-ed1c-4c25-bcd1-8cf05fa7d7aa","crdt_format_version":1,"crdt_data":{"title":{"r":"0SYUJ7Mu47b0KFZgdx2P3A,\"start\",\"end\"","n":{"0SYUJ7Mu47b0KFZgdx2P3A,\"start\",\"end\"":{"s":{"x":"0SYUJ7Mu47b0KFZgdx2P3A","i":[{"t":"s"},{"t":"t","i":["k9PHe65fZmSV",1],"o":"start","l":1162,"c":"«СКАЗКА РИХТЕРА» дает представление о жизни Святослава Рихтера (1915–1997), одного из величайших советских пианистов в истории музыки. Жизнь этого немецко-русского пианиста-виртуоза характеризовалась бегством от реальности сталинского режима в безграничный и ничем не ограниченный мир музыки. «Политика меня не интересует», — говорил Рихтер. Однако его судьба была пронизана этим: отец Рихтера был казнен по ложному обвинению, его мать бежала в Германию вместе с отступающими немецкими войсками, а сам Рихтер, едва избежав ареста, играл на похоронах Сталина. Произведение представляет собой фантазию на тему взаимоотношений художника и власти. Он основан на документах из архива Рихтера, а также на интервью самого художника, его коллег и близких друзей. Спектакль рассказывает историю музыкального гения, который был вынужден изобрести свой собственный «свободный мир», чтобы держаться как можно дальше от диктаторского правления, тоталитаризма и застоя. Сочетая живую музыку, элементы драматического и документального театра, а также кукольного театра и клоунады, на сцену выходит необыкновенная и фантастическая история... сказка об этой уникальной личности. "},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"34526b52-4dae-4b1e-abae-db126fad1d88":{"value":{"value":{"id":"34526b52-4dae-4b1e-abae-db126fad1d88","version":13,"type":"column_list","content":["fec02954-6d60-4770-9bc2-1ca1cadc784c","f7c7aed1-3fbb-4ef3-acf2-d404d3a58f79"],"created_time":1714839929037,"last_edited_time":1720032959949,"parent_id":"bff66483-1311-4867-b890-06db1f958ce6","parent_table":"block","alive":true,"space_id":"b4d03d33-ed1c-4c25-bcd1-8cf05fa7d7aa","crdt_format_version":1,"crdt_data":{"title":{"r":"_CQVuOMIV0Ub3y5nWspT0A,\"start\",\"end\"","n":{"_CQVuOMIV0Ub3y5nWspT0A,\"start\",\"end\"":{"s":{"x":"_CQVuOMIV0Ub3y5nWspT0A","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"5da55de4-f836-4ebf-a8a4-4415b8f7806f":{"value":{"value":{"id":"5da55de4-f836-4ebf-a8a4-4415b8f7806f","version":4,"type":"text","created_time":1720032934458,"last_edited_time":1720032934458,"parent_id":"bff66483-1311-4867-b890-06db1f958ce6","parent_table":"block","alive":true,"space_id":"b4d03d33-ed1c-4c25-bcd1-8cf05fa7d7aa","crdt_format_version":1,"crdt_data":{"title":{"r":"coQ3n_dQFlrBSxsm85tGrQ,\"start\",\"end\"","n":{"coQ3n_dQFlrBSxsm85tGrQ,\"start\",\"end\"":{"s":{"x":"coQ3n_dQFlrBSxsm85tGrQ","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"fec02954-6d60-4770-9bc2-1ca1cadc784c":{"spaceId":"b4d03d33-ed1c-4c25-bcd1-8cf05fa7d7aa","value":{"value":{"id":"fec02954-6d60-4770-9bc2-1ca1cadc784c","version":6,"type":"column","content":["555a3ec4-fbeb-4494-a7ad-466477e180ee"],"format":{"column_ratio":0.5},"created_time":1714839929037,"last_edited_time":1714839929037,"parent_id":"34526b52-4dae-4b1e-abae-db126fad1d88","parent_table":"block","alive":true,"space_id":"b4d03d33-ed1c-4c25-bcd1-8cf05fa7d7aa","crdt_format_version":1,"crdt_data":{"title":{"r":"WBdAJQKzj47crFMDxTz42A,\"start\",\"end\"","n":{"WBdAJQKzj47crFMDxTz42A,\"start\",\"end\"":{"s":{"x":"WBdAJQKzj47crFMDxTz42A","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"f