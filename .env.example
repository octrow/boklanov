# ------------------------------------------------------------------------------
# This is an example .env file.
#
# All of these environment vars must be defined either in your environment or in
# a local .env file in order to run this app.
#
# @see https://github.com/rolodato/dotenv-safe for more details.
# ------------------------------------------------------------------------------

# CDN base URL for production images (leave empty for local dev)
# Temp (rate-limited): https://pub-eaff....4ac582b0.r2.dev
# Production: https://cdn.boklanov.com (requires boklanov.com DNS on Cloudflare)
NEXT_PUBLIC_CDN_BASE=

# Cloudflare R2 credentials (for npm run upload-images)
# Get from: Cloudflare dash → R2 → Manage R2 API Tokens → Create Token (Read+Write)
R2_ACCOUNT_ID=
R2_BUCKET=boklanov-content
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Keystatic (CMS at /keystatic) needs no env vars: storage kind is
# auto-derived from NODE_ENV (local in dev, cloud in prod). Auth is via
# https://keystatic.cloud (project boklanov/boklanov).

# ──────────────────────────────────────────────────────────────────────────
# Payload 3 (CMS at /admin) — replaces Keystatic at cutover C.
# See .design/boklanov-rewrite/PAYLOAD_MIGRATION_PLAN.md §P1.
# ──────────────────────────────────────────────────────────────────────────

# Neon Postgres (free tier, eu-central-1). Pooled URL = runtime; unpooled = migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# openssl rand -base64 48
PAYLOAD_SECRET=

# Public site URL (used by Payload's serverURL config + admin-bar links).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# S3-compatible R2 credentials for Payload's @payloadcms/storage-s3 plugin.
# Re-use the existing boklanov-content bucket; same keys as R2_* but s3 naming.
S3_BUCKET=boklanov-content
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional (for fathom analytics)
#NEXT_PUBLIC_FATHOM_ID=

# Optional (for PostHog analytics)
#NEXT_PUBLIC_POSTHOG_ID=

# Optional (for rendering tweets more efficiently)
#TWITTER_ACCESS_TOKEN=

# Optional (for persisting preview images to redis)
# NOTE: if you want to enable redis, only REDIS_HOST and REDIS_PASSWORD are required
# NOTE: don't forget to set isRedisEnabled to true in the site.config.ts file
#REDIS_HOST=
#REDIS_PASSWORD=
#REDIS_USER='default'
#REDIS_NAMESPACE='preview-images'
