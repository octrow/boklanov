{
  "name": "boklanov-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "boklanov.com / boklanov.ru - site for theatre director Roman Boklanov.",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "browserslist": [
    "chrome >= 110",
    "edge >= 110",
    "firefox >= 110",
    "safari >= 15.6",
    "ios_saf >= 15.6"
  ],
  "scripts": {
    "predev": "npm run payload:generate:importmap",
    "dev": "next dev",
    "prebuild": "npm run payload:generate:types && npm run payload:generate:importmap",
    "build": "next build",
    "upload-images": "tsx scripts/upload-images.ts",
    "lint-content": "tsx scripts/lint-content.ts",
    "translate-content": "tsx scripts/translate-content.ts",
    "payload": "PAYLOAD_CONFIG_PATH=payload.config.ts payload",
    "payload:generate:types": "PAYLOAD_CONFIG_PATH=payload.config.ts payload generate:types",
    "payload:generate:importmap": "PAYLOAD_CONFIG_PATH=payload.config.ts payload generate:importmap",
    "payload:seed": "tsx scripts/seed-payload.ts",
    "payload:backfill-media": "tsx scripts/backfill-media.ts",
    "bake-variants": "UV_THREADPOOL_SIZE=32 MALLOC_ARENA_MAX=2 tsx scripts/bake-image-variants.ts",
    "lint-tokens": "tsx scripts/lint-tokens.ts",
    "start": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "test": "run-p test:*",
    "test:lint": "eslint '**/*.{ts,tsx}'",
    "test:prettier": "prettier '**/*.{js,jsx,ts,tsx}' --check",
    "vercel-build": "DATABASE_URL=${DATABASE_URL_UNPOOLED:-$DATABASE_URL} npm run payload -- migrate && npm run build",
    "payload:port-delta": "tsx scripts/port-content-delta.ts",
    "db:dev-refresh": "bash scripts/db-dev-refresh.sh"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "undici": "^7.30.0",
    "dompurify": "^3.4.16"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@floating-ui/react": "^0.27.20",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-s3": "^3.90.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "classnames": "^2.5.1",
    "graphql": "^16.14.2",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "openai": "^6.49.0",
    "p-map": "^7.1.0",
    "payload": "^3.90.2",
    "posthog-js": "^1.438.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/lib-storage": "^3.1149.0",
    "@fisch0920/config": "^1.4.1",
    "@next/bundle-analyzer": "^15.5.27",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "cli-progress": "^3.12.0",
    "cross-env": "^10.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
