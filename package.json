{
  "name": "boklanov-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "boklanov.com / boklanov.ru — site for theatre director Roman Boklanov.",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "sync": "tsx scripts/sync-from-notion.ts",
    "start": "next start",
    "deploy": "vercel deploy",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "test": "run-p test:*",
    "test:lint": "eslint '**/*.{ts,tsx}'",
    "test:prettier": "prettier '**/*.{js,jsx,ts,tsx}' --check"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@vercel/og": "^0.0.19",
    "classnames": "^2.5.1",
    "fathom-client": "^3.4.1",
    "gray-matter": "^4.0.3",
    "lqip-modern": "^2.2.1",
    "next": "^15.5.3",
    "next-intl": "^4.11.0",
    "next-mdx-remote": "^6.0.0",
    "p-map": "^7.0.3",
    "posthog-js": "^1.249.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@fisch0920/config": "^1.2.1",
    "@next/bundle-analyzer": "^15.3.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "cross-env": "^10.0.0",
    "csv-parse": "^6.2.1",
    "eslint": "^9.35.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "yaml": "^2.8.3"
  }
}
